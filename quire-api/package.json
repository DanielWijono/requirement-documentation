{
  "name": "quire-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "check": "tsc --noEmit && oxlint && vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:seed": "tsx src/cli/seed.ts",
    "bootstrap-admin": "tsx src/cli/bootstrap-admin.ts"
  },
  "dependencies": {
    "@hocuspocus/server": "^4.7.0",
    "@hono/node-server": "^2.1.1",
    "@quire/editor": "*",
    "@quire/shared": "*",
    "@tiptap/html": "^3.31.3",
    "@tiptap/y-tiptap": "^3.0.9",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.8",
    "nodemailer": "^10.0.10",
    "postgres": "^3.4.9",
    "sanitize-html": "^2.17.7",
    "tsx": "^4.23.15",
    "ws": "^8.21.3",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.7.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.1",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^3.2.7",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vitest": "^3.2.7"
  }
