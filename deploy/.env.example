# Production settings for compose.prod.yaml. Copy to .env in the repository root and fill in every value:
#   cp deploy/.env.example .env

# The domain people open, pointed at this server (an A/AAAA record). Caddy gets its TLS certificate.
DOMAIN=docs.example.com

# Database password (long and random, e.g. `openssl rand -hex 24`). Only the containers use it.
POSTGRES_PASSWORD=

# Signs sessions. At least 32 characters, e.g. `openssl rand -hex 32`. Changing it signs everyone out.
BETTER_AUTH_SECRET=

# Outgoing email for invites and password resets (your provider's SMTP settings).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (TLS from the start); false for 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Quire <no-reply@example.com>

# Backups: hour of day (UTC, two digits) and how many days of dumps to keep in ./backups.
BACKUP_HOUR=02
BACKUP_KEEP_DAYS=14
